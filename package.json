{
  "name": "diarhythm",
  "productName": "DiaRhythm",
  "version": "0.1.0",
  "description": "Local-first desktop diabetes-management companion with optional Presage SmartSpectra breathing/pulse sensing.",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "dist/electron/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "package:linux": "npm run build && electron-builder --linux AppImage",
    "test": "vitest run",
    "lint": "eslint --ext .ts,.tsx src tests",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@smartspectra/node-sdk": "^3.5.0",
    "better-sqlite3": "^13.2.0",
    "dotenv": "^16.6.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.10",
    "@types/electron": "^1.6.12",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^42.11.16",
    "electron-builder": "^26.18.0",
    "electron-vite": "^2.2.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "prettier": "^3.3.2",
    "typescript": "~5.5.4",
    "vite": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "build": {
    "appId": "org.diarhythm.desktop",
    "productName": "DiaRhythm",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/electron/**/*",
      "package.json",
      "!**/.env*",
      "!**/*.sqlite*"
    ],
    "extraResources": [
      {
        "from": "node_modules/@smartspectra/node-sdk-linux-x64",
        "to": "smartspectra/node-sdk-linux-x64"
      }
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    }
  }
}
