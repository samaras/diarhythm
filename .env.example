# DiaRhythm environment configuration
# Copy this file to `.env` (gitignored) and fill in your own values.
# Never commit real credentials to source control.

# Presage SmartSpectra SDK API key — server-validated authentication for the
# physiological sensing pipeline. Obtain from the SmartSpectra developer portal.
SMARTSPECTRA_API_KEY=your_api_key_here

# SDK diagnostics logging (opt-in). Logs to the renderer/main DevTools console.
# SMARTSPECTRA_DIAGNOSTICS=1